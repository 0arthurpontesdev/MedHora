// ===============================================================
// Assumed Data Model
// ===============================================================
// users/{uid}: private identity profile
// users/{uid}/medications/{id}: owner medication and schedule
// users/{uid}/doses/{doseKey}: recorded taken dose
// users/{uid}/members/{memberUid}: read-only family access grant
// users/{uid}/connections/{ownerUid}: agenda accepted by this user
// users/{uid}/pushTokens/{tokenHash}: private FCM device token
// users/{uid}/settings/notifications: legacy e-mail preference
// users/{uid}/deliveries/{doseKey}: scheduler-only delivery record
// invitations/{inviteId}: one recipient-specific family invitation

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function isOwner(userId) { return isAuthenticated() && request.auth.uid == userId; }
    function isMember(userId) {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(userId)/members/$(request.auth.uid));
    }
    function isManagedMinor(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)/control/access) &&
        get(/databases/$(database)/documents/users/$(userId)/control/access).data.adultAt > request.time;
    }
    function isGuardian(userId) {
      return isAuthenticated() && isManagedMinor(userId) &&
        get(/databases/$(database)/documents/users/$(userId)/control/access).data.guardianUid == request.auth.uid;
    }
    function isPairedDevice(userId) {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(userId)/devices/$(request.auth.uid));
    }
    function canManageAgenda(userId) { return (isOwner(userId) && !isManagedMinor(userId)) || isGuardian(userId); }
    function canViewAgenda(userId) { return isOwner(userId) || isMember(userId) || isGuardian(userId) || isPairedDevice(userId); }
    function hasRequiredFields(data, fields) { return data.keys().hasAll(fields); }
    function hasOnlyAllowedFields(data, fields) { return data.keys().hasOnly(fields); }
    function isRecent(time) {
      return time is timestamp && time > request.time - duration.value(5, 'm') && time <= request.time;
    }
    function isValidEmail(email) {
      return email is string && email.size() >= 5 && email.size() <= 254 &&
        email.matches('^[^\\s<>@,;]+@[^\\s<>@,;]+\\.[^\\s<>@,;]+$');
    }
    function isValidTime(value) {
      return value is string && value.matches('^([01]\\d|2[0-3]):[0-5]\\d$');
    }
    function isValidTimes(values) {
      return values is list && values.size() <= 8 &&
        (values.size() < 1 || isValidTime(values[0])) &&
        (values.size() < 2 || isValidTime(values[1])) &&
        (values.size() < 3 || isValidTime(values[2])) &&
        (values.size() < 4 || isValidTime(values[3])) &&
        (values.size() < 5 || isValidTime(values[4])) &&
        (values.size() < 6 || isValidTime(values[5])) &&
        (values.size() < 7 || isValidTime(values[6])) &&
        (values.size() < 8 || isValidTime(values[7]));
    }
    function isValidUser(data, userId) {
      return hasRequiredFields(data,['uid','email','displayName','createdAt','updatedAt']) &&
        hasOnlyAllowedFields(data,['uid','email','displayName','createdAt','updatedAt']) &&
        data.uid == userId && isValidEmail(data.email) &&
        data.displayName is string && data.displayName.size() <= 120 &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function isValidMedication(data,userId,medId) {
      return hasRequiredFields(data,['id','ownerUid','name','dose','notes','start','date','freq','asNeeded','scheduleType','times','status','days','startsAt','createdAt','updatedAt']) &&
        hasOnlyAllowedFields(data,['id','ownerUid','name','dose','notes','start','date','freq','asNeeded','scheduleType','times','status','days','startsAt','createdAt','updatedAt']) &&
        data.id == medId && data.id.size() <= 100 && data.ownerUid == userId &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.dose is string && data.dose.size() >= 1 && data.dose.size() <= 500 &&
        data.notes is string && data.notes.size() <= 2000 &&
        isValidTime(data.start) && data.date is string && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        data.freq is int && data.asNeeded is bool && data.scheduleType in ['interval','times','asNeeded'] &&
        isValidTimes(data.times) && data.status in ['active','paused','ended'] &&
        ((data.scheduleType == 'asNeeded' && data.asNeeded == true && data.freq == 0 && data.times.size() == 0) ||
         (data.scheduleType == 'interval' && data.asNeeded == false && data.freq in [6,8,12,24] && data.times.size() == 0) ||
         (data.scheduleType == 'times' && data.asNeeded == false && data.freq == 0 && data.times.size() >= 1)) &&
        data.days is int && data.days >= 1 && data.days <= 365 &&
        data.startsAt is timestamp && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function isValidDose(data,userId,doseKey) {
      return hasRequiredFields(data,['doseKey','ownerUid','taken','updatedAt']) &&
        hasOnlyAllowedFields(data,['doseKey','ownerUid','taken','updatedAt']) &&
        data.doseKey == doseKey && data.doseKey.size() >= 1 && data.doseKey.size() <= 180 &&
        data.ownerUid == userId && data.taken == true && data.updatedAt is timestamp;
    }
    function isValidSettings(data,userId) {
      return hasRequiredFields(data,['ownerUid','recipientEmail','updatedAt']) &&
        hasOnlyAllowedFields(data,['ownerUid','recipientEmail','updatedAt']) &&
        data.ownerUid == userId && isValidEmail(data.recipientEmail) && data.updatedAt is timestamp;
    }
    function isValidInvitation(data,inviteId) {
      return hasRequiredFields(data,['inviteId','ownerUid','ownerName','invitedEmail','status','acceptedUid','mode','birthDate','adultAt','createdAt','updatedAt']) &&
        hasOnlyAllowedFields(data,['inviteId','ownerUid','ownerName','invitedEmail','status','acceptedUid','mode','birthDate','adultAt','createdAt','updatedAt']) &&
        data.inviteId == inviteId && inviteId.size() == 20 &&
        data.ownerUid is string && data.ownerUid.size() >= 20 && data.ownerUid.size() <= 128 &&
        data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 120 &&
        isValidEmail(data.invitedEmail) && data.status in ['pending','accepted'] &&
        data.mode in ['viewer','dependent'] && data.birthDate is string && data.birthDate.size() <= 10 && data.adultAt is timestamp &&
        ((data.mode == 'viewer' && data.birthDate == '') || (data.mode == 'dependent' && data.birthDate.matches('^\\d{4}-\\d{2}-\\d{2}$') && data.adultAt > request.time)) &&
        data.acceptedUid is string && data.acceptedUid.size() <= 128 &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function isValidMember(data,memberUid) {
      return hasRequiredFields(data,['memberUid','email','displayName','inviteId','joinedAt']) &&
        hasOnlyAllowedFields(data,['memberUid','email','displayName','inviteId','joinedAt']) &&
        data.memberUid == memberUid && isValidEmail(data.email) &&
        data.displayName is string && data.displayName.size() <= 120 &&
        data.inviteId is string && data.inviteId.size() == 20 && data.joinedAt is timestamp;
    }
    function isValidConnection(data,ownerUid) {
      return hasRequiredFields(data,['ownerUid','ownerName','inviteId','joinedAt']) &&
        hasOnlyAllowedFields(data,['ownerUid','ownerName','inviteId','joinedAt']) &&
        data.ownerUid == ownerUid && data.ownerName is string && data.ownerName.size() <= 120 &&
        data.inviteId is string && data.inviteId.size() == 20 && data.joinedAt is timestamp;
    }
    function isValidPushToken(data,userId) {
      return hasRequiredFields(data,['ownerUid','token','enabled','platform','createdAt','updatedAt']) &&
        hasOnlyAllowedFields(data,['ownerUid','token','enabled','platform','createdAt','updatedAt']) &&
        data.ownerUid == userId && data.token is string && data.token.size() >= 20 && data.token.size() <= 4096 &&
        data.enabled is bool && data.platform is string && data.platform.size() <= 300 &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function isValidControl(data) {
      return hasRequiredFields(data,['guardianUid','guardianName','birthDate','adultAt','inviteId','createdAt']) &&
        hasOnlyAllowedFields(data,['guardianUid','guardianName','birthDate','adultAt','inviteId','createdAt']) &&
        data.guardianUid is string && data.guardianUid.size() >= 20 && data.guardianUid.size() <= 128 &&
        data.guardianName is string && data.guardianName.size() >= 1 && data.guardianName.size() <= 120 &&
        data.birthDate is string && data.birthDate.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        data.adultAt is timestamp && data.adultAt > request.time && data.inviteId is string && data.inviteId.size() == 20 && data.createdAt is timestamp;
    }
    function isValidDependent(data,dependentUid) {
      return hasRequiredFields(data,['dependentUid','displayName','email','birthDate','adultAt','inviteId','joinedAt']) &&
        hasOnlyAllowedFields(data,['dependentUid','displayName','email','birthDate','adultAt','inviteId','joinedAt']) &&
        data.dependentUid == dependentUid && data.displayName is string && data.displayName.size() <= 120 &&
        isValidEmail(data.email) && data.birthDate is string && data.birthDate.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        data.adultAt is timestamp && data.adultAt > request.time && data.inviteId is string && data.inviteId.size() == 20 && data.joinedAt is timestamp;
    }
    function isValidDevice(data,deviceUid) {
      return hasRequiredFields(data,['deviceUid','label','pairId','platform','createdAt','lastSeenAt']) &&
        hasOnlyAllowedFields(data,['deviceUid','label','pairId','platform','createdAt','lastSeenAt']) &&
        data.deviceUid == deviceUid && data.label is string && data.label.size() <= 60 &&
        data.pairId is string && data.pairId.size() == 64 && data.platform is string && data.platform.size() <= 300 &&
        data.createdAt is timestamp && data.lastSeenAt is timestamp;
    }
    function isValidPairing(data,pairId) {
      return hasRequiredFields(data,['pairId','ownerUid','ownerName','status','claimedUid','expiresAt','createdAt','updatedAt']) &&
        hasOnlyAllowedFields(data,['pairId','ownerUid','ownerName','status','claimedUid','expiresAt','createdAt','updatedAt']) &&
        data.pairId == pairId && pairId.size() == 64 && data.ownerUid is string && data.ownerUid.size() >= 20 && data.ownerUid.size() <= 128 &&
        data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 120 &&
        data.status in ['pending','claimed'] && data.claimedUid is string && data.claimedUid.size() <= 128 &&
        data.expiresAt is timestamp && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data,userId) &&
        request.resource.data.uid == userId && isRecent(request.resource.data.createdAt) && isRecent(request.resource.data.updatedAt);
      allow update: if isOwner(userId) && isValidUser(request.resource.data,userId) &&
        request.resource.data.uid == resource.data.uid && request.resource.data.createdAt == resource.data.createdAt &&
        isRecent(request.resource.data.updatedAt);
      allow delete: if false;

      match /medications/{medId} {
        allow read: if canViewAgenda(userId);
        allow create: if canManageAgenda(userId) && exists(/databases/$(database)/documents/users/$(userId)) &&
          isValidMedication(request.resource.data,userId,medId) && isRecent(request.resource.data.createdAt) && isRecent(request.resource.data.updatedAt);
        allow update: if canManageAgenda(userId) && isValidMedication(request.resource.data,userId,medId) &&
          request.resource.data.ownerUid == resource.data.ownerUid && request.resource.data.id == resource.data.id &&
          request.resource.data.createdAt == resource.data.createdAt && isRecent(request.resource.data.updatedAt);
        allow delete: if canManageAgenda(userId) && resource.data.ownerUid == userId;
      }
      match /doses/{doseKey} {
        allow read: if canViewAgenda(userId);
        allow create: if (isOwner(userId) || isGuardian(userId) || isPairedDevice(userId)) && exists(/databases/$(database)/documents/users/$(userId)) &&
          isValidDose(request.resource.data,userId,doseKey) && isRecent(request.resource.data.updatedAt);
        allow update: if (isOwner(userId) || isGuardian(userId) || isPairedDevice(userId)) && isValidDose(request.resource.data,userId,doseKey) &&
          request.resource.data.ownerUid == resource.data.ownerUid && isRecent(request.resource.data.updatedAt);
        allow delete: if (isOwner(userId) || isGuardian(userId) || isPairedDevice(userId)) && resource.data.ownerUid == userId;
      }
      match /members/{memberUid} {
        allow read: if isOwner(userId) || (isAuthenticated() && request.auth.uid == memberUid);
        allow create: if isAuthenticated() && request.auth.uid == memberUid &&
          isValidMember(request.resource.data,memberUid) && request.resource.data.email == request.auth.token.email &&
          getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.inviteId)).data.ownerUid == userId &&
          getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.inviteId)).data.acceptedUid == memberUid;
        allow update: if false;
        allow delete: if isOwner(userId) || (isAuthenticated() && request.auth.uid == memberUid);
      }
      match /connections/{ownerUid} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidConnection(request.resource.data,ownerUid) &&
          getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.inviteId)).data.ownerUid == ownerUid &&
          getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.inviteId)).data.acceptedUid == userId;
        allow update: if false;
        allow delete: if isOwner(userId) || (isAuthenticated() && request.auth.uid == resource.data.ownerUid);
      }
      match /dependents/{dependentUid} {
        allow read: if isOwner(userId);
        allow create: if isAuthenticated() && request.auth.uid == dependentUid && isValidDependent(request.resource.data,dependentUid) &&
          getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.inviteId)).data.mode == 'dependent' &&
          getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.inviteId)).data.ownerUid == userId &&
          getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.inviteId)).data.acceptedUid == dependentUid;
        allow update: if false;
        allow delete: if isOwner(userId) || (isAuthenticated() && request.auth.uid == dependentUid);
      }
      match /control/{controlId} {
        allow read: if controlId == 'access' && (isOwner(userId) || isGuardian(userId));
        allow create: if controlId == 'access' && isOwner(userId) && isValidControl(request.resource.data) &&
          getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.inviteId)).data.mode == 'dependent' &&
          getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.inviteId)).data.ownerUid == request.resource.data.guardianUid &&
          getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.inviteId)).data.acceptedUid == userId;
        allow update: if false;
        allow delete: if controlId == 'access' && (isGuardian(userId) || (isOwner(userId) && resource.data.adultAt <= request.time));
      }
      match /devices/{deviceUid} {
        allow read: if isOwner(userId) || (isAuthenticated() && request.auth.uid == deviceUid);
        allow create: if isAuthenticated() && request.auth.uid == deviceUid && isValidDevice(request.resource.data,deviceUid) &&
          getAfter(/databases/$(database)/documents/pairings/$(request.resource.data.pairId)).data.ownerUid == userId &&
          getAfter(/databases/$(database)/documents/pairings/$(request.resource.data.pairId)).data.status == 'claimed' &&
          getAfter(/databases/$(database)/documents/pairings/$(request.resource.data.pairId)).data.claimedUid == deviceUid;
        allow update: if false;
        allow delete: if isOwner(userId) || (isAuthenticated() && request.auth.uid == deviceUid);
      }
      match /pushTokens/{tokenId} {
        allow read: if isOwner(userId);
        allow create: if (isOwner(userId) || isPairedDevice(userId)) && isValidPushToken(request.resource.data,userId) &&
          isRecent(request.resource.data.createdAt) && isRecent(request.resource.data.updatedAt);
        allow update: if (isOwner(userId) || isPairedDevice(userId)) && isValidPushToken(request.resource.data,userId) &&
          request.resource.data.ownerUid == resource.data.ownerUid && request.resource.data.createdAt == resource.data.createdAt &&
          isRecent(request.resource.data.updatedAt);
        allow delete: if isOwner(userId) || isPairedDevice(userId);
      }
      match /settings/{settingId} {
        allow read: if isOwner(userId) && settingId == 'notifications';
        allow create: if isOwner(userId) && settingId == 'notifications' && isValidSettings(request.resource.data,userId) && isRecent(request.resource.data.updatedAt);
        allow update: if isOwner(userId) && settingId == 'notifications' && isValidSettings(request.resource.data,userId) && request.resource.data.ownerUid == resource.data.ownerUid && isRecent(request.resource.data.updatedAt);
        allow delete: if isOwner(userId) && settingId == 'notifications';
      }
      match /deliveries/{deliveryId} { allow read,write: if false; }
      match /{document=**} { allow read,write: if false; }
    }

    match /invitations/{inviteId} {
      allow get: if isAuthenticated() && (request.auth.uid == resource.data.ownerUid ||
        (request.auth.token.email_verified == true && request.auth.token.email == resource.data.invitedEmail));
      allow list: if false;
      allow create: if isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        isValidInvitation(request.resource.data,inviteId) && request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.status == 'pending' && request.resource.data.acceptedUid == '' &&
        isRecent(request.resource.data.createdAt) && isRecent(request.resource.data.updatedAt);
      allow update: if isAuthenticated() && request.auth.token.email_verified == true &&
        isValidInvitation(request.resource.data,inviteId) && request.auth.token.email == resource.data.invitedEmail &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','acceptedUid','updatedAt']) &&
        resource.data.status == 'pending' && request.resource.data.status == 'accepted' &&
        request.resource.data.acceptedUid == request.auth.uid && isRecent(request.resource.data.updatedAt);
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.ownerUid;
    }
    match /pairings/{pairId} {
      allow get: if isAuthenticated() && (request.auth.uid == resource.data.ownerUid ||
        (resource.data.status == 'pending' && resource.data.expiresAt > request.time) || resource.data.claimedUid == request.auth.uid);
      allow list: if false;
      allow create: if isAuthenticated() && request.auth.token.email_verified == true &&
        isValidPairing(request.resource.data,pairId) && request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.status == 'pending' && request.resource.data.claimedUid == '' &&
        request.resource.data.expiresAt > request.time && request.resource.data.expiresAt <= request.time + duration.value(601,'s') &&
        isRecent(request.resource.data.createdAt) && isRecent(request.resource.data.updatedAt);
      allow update: if isAuthenticated() && request.auth.uid != resource.data.ownerUid &&
        isValidPairing(request.resource.data,pairId) && resource.data.status == 'pending' && resource.data.expiresAt > request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','claimedUid','updatedAt']) &&
        request.resource.data.status == 'claimed' && request.resource.data.claimedUid == request.auth.uid &&
        getAfter(/databases/$(database)/documents/users/$(resource.data.ownerUid)/devices/$(request.auth.uid)).data.pairId == pairId &&
        isRecent(request.resource.data.updatedAt);
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.ownerUid;
    }
    match /{document=**} { allow read,write: if false; }
  }
}
